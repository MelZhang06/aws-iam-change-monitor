index=aws_security_enterprise_demo sourcetype=aws:cloudtrail:demo
| dedup eventID
| eval account_id=recipientAccountId, principal_arn='userIdentity.arn', identity_type='userIdentity.type', actor=coalesce('userIdentity.userName', 'userIdentity.arn', "unknown"), src=sourceIPAddress, login_result='responseElements.ConsoleLogin', mfa_used='additionalEventData.MFAUsed', target_user='requestParameters.userName', policy_arn='requestParameters.policyArn'
| eval actor=if(actor="HIDDEN_DUE_TO_SECURITY_REASONS", "unknown", actor)
| eval outcome=case(eventName="ConsoleLogin", login_result, isnotnull(errorCode) AND errorCode!="success", "Denied", true(), "Success")
| where account_id=$selected_account|s$ AND principal_arn=$selected_principal|s$ AND src=$selected_src|s$ AND _time>=tonumber($selected_start|s$) AND _time<tonumber($selected_end|s$)
| eval Time=strftime(_time,"%d %b %H:%M:%S %Z"), Evidence=case(eventName="ConsoleLogin" AND login_result="Failure","Failed sign-in",eventName="ConsoleLogin" AND login_result="Success" AND mfa_used="No","Successful sign-in without MFA",eventName="ConsoleLogin","Successful sign-in with MFA",eventName="AttachUserPolicy","Policy attachment",eventName="CreateAccessKey","Access key creation",true(),eventName), MFA=coalesce(mfa_used,"N/A"), Target=coalesce(target_user,"N/A"), Policy=coalesce(policy_arn,"N/A")
| sort 0 _time eventID
| table Time actor Evidence outcome MFA Target Policy
| rename actor as "Caller" outcome as "Outcome"
